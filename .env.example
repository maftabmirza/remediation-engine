# AIOps Platform Configuration
# Copy this to .env and update values

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change_this_secure_password

# Authentication
JWT_SECRET=change_this_to_a_random_secret_key_at_least_32_chars
JWT_EXPIRY_HOURS=24
ENCRYPTION_KEY=change_this_to_a_random_fernet_key_generated_by_cryptography

# Initial Admin User (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# GOOGLE_API_KEY=your-key-here

# App Settings
DEBUG=false
APP_PORT=8080

# Public URL of this server (used by Prometheus external-url and Grafana root_url)
# Change this to the new server's IP or domain on redeployment
AIOPS_PUBLIC_URL=http://YOUR_SERVER_IP:8080
AIOPS_PUBLIC_DOMAIN=YOUR_SERVER_IP

# =============================================================================
# Prometheus Integration
# =============================================================================

# Internal URL used by the app to query Prometheus.
# IMPORTANT: Must include the /prometheus path prefix because Prometheus runs
# with --web.route-prefix=/prometheus. Changing this prefix requires updating
# this value, tempo/tempo.yaml (remote_write), and grafana/provisioning/datasources.
PROMETHEUS_URL=http://prometheus:9090/prometheus
ENABLE_PROMETHEUS_QUERIES=true
PROMETHEUS_TIMEOUT=30

# Dashboard Settings
PROMETHEUS_DASHBOARD_ENABLED=true
PROMETHEUS_REFRESH_INTERVAL=30
PROMETHEUS_DEFAULT_TIME_RANGE=24h

# Infrastructure Metrics
INFRASTRUCTURE_METRICS_ENABLED=true
INFRASTRUCTURE_SHOW_CPU=true
INFRASTRUCTURE_SHOW_MEMORY=true
INFRASTRUCTURE_SHOW_DISK=true

# Warning Thresholds (percentage)
INFRASTRUCTURE_CPU_WARNING_THRESHOLD=75
INFRASTRUCTURE_CPU_CRITICAL_THRESHOLD=90
INFRASTRUCTURE_MEMORY_WARNING_THRESHOLD=75
INFRASTRUCTURE_MEMORY_CRITICAL_THRESHOLD=90
INFRASTRUCTURE_DISK_WARNING_THRESHOLD=75
INFRASTRUCTURE_DISK_CRITICAL_THRESHOLD=90

# Chart Configuration
CHART_LIBRARY=echarts
CHART_THEME=grafana-dark
CHART_ENABLE_ZOOM=true
CHART_ENABLE_ANIMATIONS=true
CHART_MAX_DATA_POINTS=1000

# Alert Trends
ALERT_TRENDS_ENABLED=true
ALERT_TRENDS_DEFAULT_HOURS=24
ALERT_TRENDS_STEP=1h

# Query Optimization
PROMETHEUS_USE_CACHE=true
PROMETHEUS_CACHE_TTL=60
PROMETHEUS_MAX_RETRIES=3
PROMETHEUS_RETRY_DELAY=2

# =============================================================================
# Grafana Integration
# =============================================================================
# Internal Grafana URL for the remediation-engine app (needs /grafana sub-path
# because Grafana runs with GF_SERVER_SERVE_FROM_SUB_PATH=true).
GRAFANA_URL=http://grafana:3000/grafana
# Grafana admin password (also used for service account creation)
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# =============================================================================
# MCP Grafana Integration (Model Context Protocol)
# =============================================================================
# Service Account Token - AUTO-GENERATED on first deployment by setup script
# Run: ./scripts/setup-mcp-grafana.sh to create this automatically
# Or manually create via Grafana UI: Administration > Service Accounts > Add
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# MCP Grafana URL (internal Docker network)
MCP_GRAFANA_URL=http://mcp-grafana:8000

# =============================================================================
# CyberArk Identity SAML 2.0 SSO (optional — leave blank to use local auth)
# =============================================================================
# These values are only needed as a bootstrap reference.
# Production config is stored in the database via POST /api/auth/config.
#
# Step 1: Register this app as a SAML Service Provider in CyberArk Identity.
# Step 2: Set the ACS URL in CyberArk to: https://<your-domain>/api/auth/saml/acs
# Step 3: Set the Entity ID in CyberArk to: https://<your-domain>/api/auth/saml/metadata
# Step 4: POST to /api/auth/config (as admin) with:
#   {
#     "method": "cyberark_saml",
#     "cyberark_config": {
#       "idp_metadata_url": "<CyberArk tenant metadata URL>",
#       "sp_entity_id":     "https://<your-domain>/api/auth/saml/metadata",
#       "sp_acs_url":       "https://<your-domain>/api/auth/saml/acs",
#       "attribute_email":  "email",
#       "attribute_username": "username",
#       "attribute_role":   "role",
#       "role_mapping": {
#         "CyberArk_Admins":   "admin",
#         "CyberArk_Ops":      "operator",
#         "CyberArk_Viewers":  "viewer"
#       },
#       "auto_provision": true,
#       "default_role": "viewer"
#     }
#   }
#
# Check SSO status at: GET /api/auth/saml/status
# Download SP metadata for CyberArk admin at: GET /api/auth/saml/metadata
# CYBERARK_IDP_METADATA_URL=https://your-tenant.cyberark.cloud/saml/metadata/<app-id>
